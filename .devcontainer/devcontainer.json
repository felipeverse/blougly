{
    "name": "Blougly (PHP 8.3)",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": "..",
        "target": "dev"
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/blougly,type=bind",
    "workspaceFolder": "/blougly",
    "remoteUser": "root",
    "customizations": {
        "vscode": {
            "extensions": [
                "editorconfig.editorconfig",
                "donjayamanne.githistory",
                "eamodio.gitlens",
                "christian-kohler.path-intellisense",
                "esbenp.prettier-vscode",
                "bmewburn.vscode-intelephense-client",
                "ecodes.vscode-phpmd",
                "xdebug.php-debug",
                "recca0120.vscode-phpunit",
                "mehedidracula.php-namespace-resolver",
                "neilbrayfield.php-docblocker",
                "shufo.vscode-blade-formatter",
                "devsense.intelli-php-vscode"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "editor.rulers": [
                    {
                        "column": 80
                    },
                    {
                        "column": 120,
                        "color": "#ff5555"
                    }
                ],
                "terminal.integrated.cwd": "/blougly",
                "php.validate.executablePath": "/usr/local/bin/php",
                "php.validate.enable": false,
                "php.suggest.basic": false,
                "phpcs.enable": true,
                "phpcs.executablePath": "/root/.composer/vendor/bin/phpcs",
                "phpcs.standard": "PSR12",
                "phpcs.autoConfigSearch": true,
                "phpcs.ignorePatterns": [
                    "*/vendor"
                ],
                "phpcs.warningSeverity": 0,
                "phpcs.errorSeverity": 0,
                "phpcs.showWarnings": true,
                "intelephense.environment.phpVersion": "8.3",
                "intelephense.files.associations": [
                    "*.php",
                    "*.phtml"
                ],
                "intelephense.completion.propertyCase": "camel",
                "intelephense.completion.withOverrideAttribute": false,
                "php-docblocker.alignParams": true,
                "php-docblocker.alignReturn": true,
                "php-docblocker.qualifyClassNames": true,
                "php-docblocker.returnGap": true,
                "phpNamespaceResolver.sortOnSave": true,
                "phpNamespaceResolver.sortMode": "alphabetical",
                "phpunit.phpunit": "/blougly/vendor/bin/pest",
                "phpunit.args": ["--configuration=/blougly/phpunit.xml"],
                "[php]": {
                    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
                    "editor.tabSize": 4,
                    "editor.insertSpaces": true,
                    "editor.rulers": [
                        {
                            "column": 80
                        },
                        {
                            "column": 120,
                            "color": "#ff5555"
                        }
                    ]
                },
                "[blade]": {
                    "editor.defaultFormatter": "shufo.vscode-blade-formatter"
                },
                "bladeFormatter.format.tabSize": 4,
                "prettier.tabWidth": 4,
                "prettier.printWidth": 250,
                "files.associations": {
                    "*.json": "json",
                    "*.blade.php": "blade"
                }
            }
        }
    },
    "postCreateCommand": "composer install",
    "postStartCommand": "[ -f vendor/autoload.php ] || composer install"
}
